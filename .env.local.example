# データベース（絶対パスで指定してください）
# 例: file:///Users/yourname/projects/gomi_map/prisma/prisma/dev.db
DATABASE_URL="file:///絶対パス/prisma/prisma/dev.db"

# watsonx.ai（未設定の場合はモックで動作します）
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://jp-tok.ml.cloud.ibm.com"

# NextAuth（変更不要）
NEXTAUTH_SECRET="hackathon-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# 近接チェックON（ハッカソン本番用）
NEXT_PUBLIC_REQUIRE_PROXIMITY=true
NEXT_PUBLIC_PROXIMITY_METERS=50

# 近接チェックOFF（デモ・開発用）
# NEXT_PUBLIC_REQUIRE_PROXIMITY=false